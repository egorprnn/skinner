{
  "private": true,
  "name": "@skinner/backend",
  "scripts": {
    "start": "./dist/index",
    "build": "bun build --compile --minify --sourcemap ./src/index.ts --outfile ./dist/index",
    "dev": "MODE=development bun run --hot ./src/index.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/routes/*/schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.621.0",
    "@azure/msal-node": "^2.9.2",
    "@hono/sentry": "^1.1.0",
    "@sentry/bun": "^8.20.0",
    "@tensorflow/tfjs-node": "^4.20.0",
    "class-transformer": "^0.5.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  }
}
